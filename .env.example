# .env로 복사한 뒤 빈 값을 모두 직접 작성하세요. 빈 값이 있으면 Compose 실행이 실패합니다.
# DB 이름과 계정은 서비스별로 구분된 기본값을 제공하며, 비밀번호와 JWT 키는 직접 지정하세요.
# JWT_SECRET은 openssl rand -base64 32로 생성한 값을 입력할 수 있습니다.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

USER_DB_NAME=user_db
USER_DB_USERNAME=user_app
USER_DB_PASSWORD=

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USERNAME=product_app
PRODUCT_DB_PASSWORD=

ORDER_DB_NAME=order_db
ORDER_DB_USERNAME=order_app
ORDER_DB_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

JWT_SECRET=

# AWS S3 Key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=cc-creator-culture
AWS_S3_PUBLIC_URL=https://d3hpfzm2zy1ewf.cloudfront.net



