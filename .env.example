# .env로 복사한 뒤 모든 값을 직접 작성하세요. 빈 값이 있으면 Compose 실행이 실패합니다.
# DB 이름과 계정은 서비스별로 구분하고 비밀번호와 JWT 키는 직접 지정하세요.
# JWT_SECRET은 openssl rand -base64 32로 생성한 값을 입력할 수 있습니다.

POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

USER_DB_NAME=
USER_DB_USERNAME=
USER_DB_PASSWORD=

PRODUCT_DB_NAME=
PRODUCT_DB_USERNAME=
PRODUCT_DB_PASSWORD=

ORDER_DB_NAME=
ORDER_DB_USERNAME=
ORDER_DB_PASSWORD=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

JWT_SECRET=
